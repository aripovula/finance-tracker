<% content_for :title, "Transactions" %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-semibold text-gray-900">Transactions</h1>
    <p class="mt-1 text-sm text-gray-500">Transactions synced from the user's connected bank accounts.</p>
  </div>
  <%= link_to "Export CSV", transactions_path(format: :csv),
        class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
</div>

<div class="mb-6 rounded-lg border border-indigo-100 bg-indigo-50 px-4 py-3 text-sm text-indigo-900">
  <p>
    <strong class="font-semibold">How this works:</strong>
    Each transaction is pulled with a cursor-based Plaid <code>/transactions/sync</code> call.
    Re-syncing only fetches what changed, not the full history again. A separate anomaly
    detector consumer flags a transaction as "Unusual" when it's more than 3x the trailing
    3-month average for that category. It only starts flagging once at least 3 prior
    transactions exist. A first purchase in a category is never flagged just for being new.
    The search and date filters below run in JavaScript, like the categories page's filter.
    They never make a request to the server. Exporting CSV always downloads every one of the
    user's transactions, not just whatever the filters are currently showing, since the server
    never finds out what they're set to.
  </p>
</div>

<div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm" data-controller="transactions-filter">
  <% if @transactions.any? %>
    <div class="flex flex-wrap items-end gap-3 border-b border-gray-200 p-4">
      <div>
        <label for="transactions-search" class="block text-xs font-medium text-gray-500">Search</label>
        <input id="transactions-search" type="search" data-transactions-filter-target="search"
               data-action="input->transactions-filter#filter"
               placeholder="Merchant or category&hellip;" aria-label="Search transactions by merchant or category"
               class="mt-1 block w-full max-w-xs rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
      </div>
      <div>
        <label for="transactions-from" class="block text-xs font-medium text-gray-500">From</label>
        <input id="transactions-from" type="date" data-transactions-filter-target="from"
               data-action="input->transactions-filter#filter" aria-label="Filter transactions posted on or after"
               class="mt-1 block rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
      </div>
      <div>
        <label for="transactions-to" class="block text-xs font-medium text-gray-500">To</label>
        <input id="transactions-to" type="date" data-transactions-filter-target="to"
               data-action="input->transactions-filter#filter" aria-label="Filter transactions posted on or before"
               class="mt-1 block rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
      </div>
    </div>

    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Merchant</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Category</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Amount</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Status</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Posted</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @transactions.each do |transaction| %>
          <tr class="hover:bg-gray-50" data-transactions-filter-target="row"
              data-search-text="<%= "#{transaction.merchant_name} #{transaction.category&.name}".downcase %>"
              data-posted-at="<%= transaction.posted_at&.to_date&.iso8601 %>">
            <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900">
              <%= link_to transaction.merchant_name.presence || "Unknown", transaction_path(transaction), class: "hover:underline" %>
              <% if transaction.flagged_anomaly_at? %>
                <span class="ml-1 inline-flex items-center rounded-full bg-orange-100 px-2 py-0.5 text-xs font-medium text-orange-800">Unusual</span>
              <% end %>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
              <% if transaction.category %>
                <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-700">
                  <%= transaction.category.name %>
                </span>
              <% else %>
                <span class="text-gray-400">Uncategorized</span>
              <% end %>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm font-medium <%= transaction_amount_class(transaction) %>">
              <%= transaction_amount_label(transaction) %>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm">
              <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= transaction.pending? ? "bg-yellow-100 text-yellow-800" : "bg-green-100 text-green-800" %>">
                <%= transaction.status.capitalize %>
              </span>
            </td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500"><%= transaction.posted_at&.strftime("%B %-d, %Y") %></td>
          </tr>
        <% end %>
        <tr data-transactions-filter-target="emptyState" hidden>
          <td colspan="5" class="px-6 py-8 text-center text-sm text-gray-500">No transactions match the user's filters.</td>
        </tr>
      </tbody>
    </table>
  <% else %>
    <p class="px-6 py-8 text-center text-sm text-gray-500">No transactions yet. Connect a bank account to get started.</p>
  <% end %>
</div>
