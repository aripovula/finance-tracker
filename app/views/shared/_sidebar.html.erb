<div data-sidebar-target="overlay" data-action="click->sidebar#close"
     class="fixed inset-0 z-40 hidden bg-gray-900/50 md:hidden"></div>

<aside data-sidebar-target="panel"
       class="fixed inset-y-0 left-0 z-50 flex w-64 -translate-x-full flex-col border-r border-gray-200 bg-white transition-transform duration-200 ease-in-out md:static md:flex md:translate-x-0">
  <div class="flex h-16 shrink-0 items-center gap-2 px-6">
    <span class="h-2 w-2 rounded-full bg-indigo-600"></span>
    <span class="text-lg font-semibold text-gray-900">Finance Tracker</span>
  </div>

  <nav class="flex-1 space-y-1 px-3">
    <%= link_to root_path, class: nav_link_class(current_page?(root_path)) do %>
      <%= nav_icon(:dashboard) %>Dashboard
    <% end %>
    <%= link_to categories_path, class: nav_link_class(current_page?(categories_path)) do %>
      <%= nav_icon(:categories) %>Categories
    <% end %>
    <%= link_to budgets_path, class: nav_link_class(request.path.start_with?(budgets_path)) do %>
      <%= nav_icon(:budgets) %>Budgets
    <% end %>
    <%= link_to bank_accounts_path, class: nav_link_class(current_page?(bank_accounts_path)) do %>
      <%= nav_icon(:bank_accounts) %>Bank accounts
    <% end %>
    <%= link_to transactions_path, class: nav_link_class(current_page?(transactions_path)) do %>
      <%= nav_icon(:transactions) %>Transactions
    <% end %>
  </nav>

  <div class="border-t border-gray-200 p-4">
    <div class="flex items-center gap-2.5">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white"
            style="background-color: <%= avatar_color(current_user.email) %>">
        <%= avatar_initial(current_user.email) %>
      </span>
      <p class="truncate text-sm font-medium text-gray-700"><%= current_user.email %></p>
    </div>
    <%= button_to "Log out", logout_path, method: :delete,
          class: "mt-3 w-full cursor-pointer rounded-md bg-gray-100 px-3 py-2 text-left text-sm font-medium text-gray-700 hover:bg-gray-200" %>
  </div>
</aside>
