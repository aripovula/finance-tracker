<% content_for :title, "Budgets" %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-semibold text-gray-900">Budgets</h1>
    <p class="mt-1 text-sm text-gray-500">Monthly spending limits by category.</p>
  </div>
  <%= link_to "New budget", new_budget_path,
        class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
</div>

<div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
  <% if @budgets.any? %>
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Category</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Monthly limit</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Effective month</th>
          <th scope="col" class="px-6 py-3"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @budgets.each do |budget| %>
          <tr class="hover:bg-gray-50">
            <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900"><%= budget.category.name %></td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500"><%= number_to_currency(budget.monthly_limit_cents / 100.0) %></td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500"><%= budget.effective_month.strftime("%B %Y") %></td>
            <td class="whitespace-nowrap px-6 py-4 text-right text-sm">
              <div class="flex items-center justify-end gap-3">
                <%= link_to "Edit", edit_budget_path(budget), class: "font-medium text-indigo-600 hover:text-indigo-500" %>
                <%= button_to "Delete", budget_path(budget), method: :delete,
                      form: { data: { turbo_confirm: "Delete this budget?" } },
                      class: "cursor-pointer border-0 bg-transparent p-0 font-medium text-red-600 hover:text-red-500" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="px-6 py-8 text-center text-sm text-gray-500">No budgets yet.</p>
  <% end %>
</div>
