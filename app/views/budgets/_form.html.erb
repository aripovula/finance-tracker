<% if @budget.errors.any? %>
  <div class="mb-4 rounded-md bg-red-50 px-4 py-3 text-sm text-red-800">
    <ul class="list-disc space-y-1 pl-5">
      <% @budget.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @budget, url: url, class: "space-y-4" do |form| %>
  <div>
    <%= form.label :category_id, "Category", class: "block text-sm font-medium text-gray-700" %>
    <%= form.collection_select :category_id, Category.order(:name), :id, :name,
          { prompt: "Select a category" },
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= form.label :monthly_limit, "Monthly limit ($)", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :monthly_limit,
          value: (@budget.monthly_limit_cents ? "%.2f" % (@budget.monthly_limit_cents / 100.0) : nil),
          inputmode: "decimal", placeholder: "500.00", required: true,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= form.label :effective_month, "Effective month", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :effective_month, type: "month",
          value: @budget.effective_month&.strftime("%Y-%m"), required: true,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit submit_label, class: "cursor-pointer rounded-md bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-500" %>
    <%= link_to "Cancel", budgets_path, class: "text-sm font-medium text-gray-700 hover:underline" %>
  </div>
<% end %>
