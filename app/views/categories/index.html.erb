<% content_for :title, "Categories" %>

<div class="w-full flex items-center justify-between">
  <h1 class="text-2xl font-semibold text-gray-900">Categories</h1>
</div>

<div class="overflow-hidden rounded-md border border-gray-200">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-2 text-left text-sm font-medium text-gray-500">Name</th>
        <th class="px-4 py-2 text-left text-sm font-medium text-gray-500">Parent category</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 bg-white">
      <% @categories.each do |category| %>
        <tr>
          <td class="px-4 py-2 text-sm text-gray-900"><%= category.name %></td>
          <td class="px-4 py-2 text-sm text-gray-500"><%= category.parent_category&.name %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
