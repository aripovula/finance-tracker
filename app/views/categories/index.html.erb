<% content_for :title, "Categories" %>

<div class="mb-6">
  <h1 class="text-2xl font-semibold text-gray-900">Categories</h1>
  <p class="mt-1 text-sm text-gray-500">Spending categories used to organize the user's transactions and budgets.</p>
</div>

<div class="mb-6 rounded-lg border border-indigo-100 bg-indigo-50 px-4 py-3 text-sm text-indigo-900">
  <p>
    <strong class="font-semibold">How this works:</strong>
    These categories come from Plaid's real Personal Finance Category taxonomy. That's about
    120 primary and detailed codes, seeded once rather than invented for this app. A
    categorizer consumer assigns one to each transaction by matching Plaid's own category
    code. A small set of merchant-name overrides catches the low-confidence generic buckets
    Plaid itself falls back to. The filter box below runs in JavaScript. It never makes a
    request to the server.
  </p>
</div>

<div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm" data-controller="category-list">
  <% if @categories.any? %>
    <div class="border-b border-gray-200 p-4">
      <input type="search" data-category-list-target="input" data-action="input->category-list#filter"
             placeholder="Filter by name&hellip;" aria-label="Filter categories by name"
             class="block w-full max-w-xs rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
    </div>

    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">
            <button type="button" data-action="category-list#toggleSort"
                    class="inline-flex cursor-pointer items-center gap-1 hover:text-gray-700">
              Name
              <span data-category-list-target="sortIcon">&uarr;</span>
            </button>
          </th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Parent category</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @categories.each do |category| %>
          <tr data-category-list-target="row" data-name="<%= category.name.downcase %>" class="hover:bg-gray-50">
            <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900"><%= category.name %></td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500">
              <% if category.parent_category %>
                <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-700">
                  <%= category.parent_category.name %>
                </span>
              <% else %>
                <span class="text-gray-400">&mdash;</span>
              <% end %>
            </td>
          </tr>
        <% end %>
        <tr data-category-list-target="emptyState" hidden>
          <td colspan="2" class="px-6 py-8 text-center text-sm text-gray-500">No categories match the user's filter.</td>
        </tr>
      </tbody>
    </table>
  <% else %>
    <p class="px-6 py-8 text-center text-sm text-gray-500">No categories yet.</p>
  <% end %>
</div>
