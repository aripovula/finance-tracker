<% content_for :title, "Dashboard" %>

<div class="mb-8">
  <h1 class="text-2xl font-semibold text-gray-900">Dashboard</h1>
</div>

<div class="mb-6 rounded-lg border border-indigo-100 bg-indigo-50 px-4 py-3 text-sm text-indigo-900">
  <p>
    <strong class="font-semibold">How this works:</strong>
    Plaid sends a webhook when a bank account has activity. That webhook is just a
    notification, not the transaction data itself. The app verifies it and publishes the
    event onto a Kafka topic. From there, independent consumers pull the real transactions
    through Plaid's API, categorize each one, check it against the user's budgets, and flag
    anomalies. The webhook carries no data, so replaying it is always safe. That's why Kafka
    fits better than RabbitMQ here: a consumer that crashes for an hour just resumes from its
    last committed offset and re-pulls. Nothing gets lost.
  </p>
</div>

<% if @budget_alerts.any? %>
  <div class="mb-6 space-y-2">
    <% @budget_alerts.each do |alert| %>
      <div class="flex items-center justify-between rounded-md bg-red-50 px-4 py-3 text-sm text-red-800">
        <p>
          <span class="font-medium"><%= alert.budget.category.name %></span> is over budget this month:
          spent <%= number_to_currency(alert.spent_cents / 100.0) %> of a
          <%= number_to_currency(alert.budget.monthly_limit_cents / 100.0) %> limit.
        </p>
        <%= button_to "Dismiss", budget_alert_path(alert), method: :patch,
              class: "cursor-pointer border-0 bg-transparent p-0 font-medium text-red-800 hover:text-red-900" %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
    <p class="text-sm font-medium text-gray-500">Spent this month</p>
    <p class="mt-2 text-2xl font-semibold text-gray-900"><%= number_to_currency(@dashboard.spent_this_month_cents / 100.0) %></p>
    <p class="mt-1 text-xs font-medium <%= kpi_delta_class(@dashboard.spent_this_month_cents, @dashboard.spent_last_month_cents, good_when: :down) %>">
      <%= kpi_delta_text(@dashboard.spent_this_month_cents, @dashboard.spent_last_month_cents) %>
    </p>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
    <p class="text-sm font-medium text-gray-500">Budget remaining</p>
    <p class="mt-2 text-2xl font-semibold text-gray-900"><%= number_to_currency(@dashboard.budget_remaining_cents / 100.0) %></p>
    <p class="mt-1 text-xs font-medium text-gray-500">
      <% if @dashboard.budget_used_pct %>
        <%= number_with_precision(@dashboard.budget_used_pct, precision: 0) %>% of <%= number_to_currency(@dashboard.total_budget_cents / 100.0) %> used
      <% else %>
        No budgets set for this month
      <% end %>
    </p>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
    <p class="text-sm font-medium text-gray-500">Invested this month</p>
    <p class="mt-2 text-2xl font-semibold text-gray-900"><%= number_to_currency(@dashboard.invested_this_month_cents / 100.0) %></p>
    <p class="mt-1 text-xs font-medium <%= kpi_delta_class(@dashboard.invested_this_month_cents, @dashboard.invested_last_month_cents, good_when: :up) %>">
      <%= kpi_delta_text(@dashboard.invested_this_month_cents, @dashboard.invested_last_month_cents) %>
    </p>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
    <% over_budget = @dashboard.over_budget_comparisons %>
    <p class="text-sm font-medium text-gray-500">Over budget</p>
    <p class="mt-2 text-2xl font-semibold text-gray-900">
      <%= over_budget.size %> <%= over_budget.size == 1 ? "category" : "categories" %>
    </p>
    <% if over_budget.empty? %>
      <p class="mt-1 text-xs font-medium text-gray-400">All categories on track</p>
    <% end %>
  </div>
</div>

<div class="mb-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
  <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
    <div class="mb-4 flex items-baseline justify-between">
      <h2 class="text-base font-semibold text-gray-900">Budget vs. actual</h2>
      <span class="text-xs text-gray-500"><%= Date.current.strftime("%B %Y") %></span>
    </div>
    <% comparisons = @dashboard.budget_comparisons %>
    <% if comparisons.any? %>
      <% name_x = 165; zero_x = 330; value_x = 590; scale = 1.4; row_height = 40 %>
      <div class="max-h-[340px] overflow-y-auto">
        <svg viewBox="0 0 600 <%= comparisons.size * row_height + 20 %>" class="w-full">
          <line x1="<%= zero_x %>" y1="4" x2="<%= zero_x %>" y2="<%= comparisons.size * row_height %>" stroke="#d1d5db" stroke-width="1"/>
          <% comparisons.each_with_index do |comparison, i| %>
            <% y_center = 30 + i * row_height %>
            <% clamped = comparison[:delta_pct].clamp(-100, 100) %>
            <% if clamped >= 0 %>
              <% bar_x = zero_x; bar_w = clamped * scale %>
            <% else %>
              <% bar_w = -clamped * scale; bar_x = zero_x - bar_w %>
            <% end %>
            <text x="<%= name_x %>" y="<%= y_center + 4 %>" font-size="11.5" text-anchor="end" fill="#111827">
              <%= truncate(comparison[:category_name], length: 20) %>
              <title><%= comparison[:category_name] %></title>
            </text>
            <% if bar_w < 1 %>
              <circle cx="<%= zero_x %>" cy="<%= y_center %>" r="4.5" fill="<%= budget_status_color(comparison[:status]) %>"/>
            <% else %>
              <rect x="<%= bar_x %>" y="<%= y_center - 11 %>" width="<%= bar_w %>" height="22" rx="4" fill="<%= budget_status_color(comparison[:status]) %>"/>
            <% end %>
            <% sign = comparison[:delta_pct] >= 0 ? "+" : "−" %>
            <% pct_label = "#{sign}#{number_with_precision(comparison[:delta_pct].abs, precision: 0)}%" %>
            <text x="<%= value_x %>" y="<%= y_center + 4 %>" font-size="11" text-anchor="end" fill="#6b7280"><%= pct_label %></text>
          <% end %>
        </svg>
      </div>

      <% cut = comparisons.select { |c| c[:status] == :critical } %>
      <% room = comparisons.select { |c| c[:status] == :good } %>
      <div class="mt-4 space-y-2">
        <% if cut.any? %>
          <% cut_total_cents = cut.sum { |c| c[:spent_cents] - c[:budget_cents] } %>
          <div class="flex gap-2 rounded-lg border border-gray-200 bg-gray-50 p-3">
            <div class="w-1 shrink-0 rounded bg-red-600"></div>
            <p class="text-xs leading-relaxed text-gray-600">
              <strong class="font-semibold text-gray-900">Cut back:</strong>
              <%= pluralize(cut.size, "budget category") %> for a total of <%= number_to_currency(cut_total_cents / 100.0) %> over.
            </p>
          </div>
        <% end %>
        <% if room.any? %>
          <% room_total_cents = room.sum { |c| c[:budget_cents] - c[:spent_cents] } %>
          <div class="flex gap-2 rounded-lg border border-gray-200 bg-gray-50 p-3">
            <div class="w-1 shrink-0 rounded bg-green-600"></div>
            <p class="text-xs leading-relaxed text-gray-600">
              <strong class="font-semibold text-gray-900">Room to spend:</strong>
              <%= pluralize(room.size, "budget category") %> for a total of <%= number_to_currency(room_total_cents / 100.0) %> left.
            </p>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= empty_state(:budgets) do %>
        No budgets set for this month.
        <%= link_to "Set one up", new_budget_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %>.
      <% end %>
    <% end %>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm lg:row-span-2 lg:self-start" data-controller="category-chart">
    <h2 class="mb-4 text-base font-semibold text-gray-900">Spending by category</h2>
    <% breakdown = @dashboard.category_breakdown(months_count: 4) %>
    <% if breakdown[:rows].any? { |row| row[:values].sum.positive? } %>
      <% chart_width = 480; chart_height = 620; bottom_pad = 24; top_pad = 10 %>
      <% plot_height = chart_height - bottom_pad - top_pad %>
      <% max_total = [ breakdown[:rows].map { |row| row[:values].sum }.max, 1 ].max %>
      <% band = chart_width / breakdown[:rows].size.to_f %>
      <% bar_width = [ band * 0.5, 56 ].min %>
      <svg viewBox="0 0 <%= chart_width %> <%= chart_height %>" class="w-full">
        <% breakdown[:rows].each_with_index do |row, month_i| %>
          <% y_cursor = chart_height - bottom_pad %>
          <% row[:values].each_with_index do |value, series_i| %>
            <% next if value.zero? %>
            <% series_name = breakdown[:series_names][series_i] %>
            <% tooltip = "#{series_name}: #{number_to_currency(value / 100.0)}" %>
            <% bar_x = month_i * band + (band - bar_width) / 2 %>
            <% seg_height = (value / max_total.to_f) * plot_height %>
            <% seg_y = y_cursor - seg_height %>
            <% is_top_segment = row[:values][(series_i + 1)..].all?(&:zero?) %>
            <% shape_attrs = %(data-category-chart-target="segment" data-series-index="#{series_i}" data-action="mouseenter->category-chart#highlight mouseleave->category-chart#unhighlight" class="cursor-default") %>
            <% if is_top_segment %>
              <path d="<%= rounded_top_bar_path(x: bar_x, y: seg_y, width: bar_width, height: seg_height) %>" fill="<%= category_series_color(series_name, series_i) %>" <%= shape_attrs.html_safe %>><title><%= tooltip %></title></path>
            <% else %>
              <rect x="<%= bar_x %>" y="<%= seg_y %>" width="<%= bar_width %>" height="<%= seg_height %>" fill="<%= category_series_color(series_name, series_i) %>" <%= shape_attrs.html_safe %>><title><%= tooltip %></title></rect>
            <% end %>
            <% y_cursor = seg_y %>
          <% end %>
          <text x="<%= month_i * band + band / 2 %>" y="<%= chart_height - 6 %>" font-size="11" text-anchor="middle" fill="#6b7280"><%= row[:month].strftime("%b") %></text>
        <% end %>
      </svg>

      <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
        <% breakdown[:series_names].each_with_index do |name, i| %>
          <div class="flex items-center gap-1.5 text-xs text-gray-600" data-category-chart-target="legendItem" data-series-index="<%= i %>">
            <span data-role="dot" class="inline-block h-2.5 w-2.5 rounded-full ring-offset-1 transition" style="background-color: <%= category_series_color(name, i) %>"></span>
            <span data-role="label" class="transition-colors"><%= name %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= empty_state(:chart) do %>
        No spending data yet. Browse the user's
        <%= link_to "categories", categories_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %>
        or connect a <%= link_to "bank account", bank_accounts_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %>
        to get started.
      <% end %>
    <% end %>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
    <div class="mb-4 flex items-baseline justify-between">
      <h2 class="text-base font-semibold text-gray-900">Spending trend</h2>
      <span class="text-xs text-gray-500">Last 4 months</span>
    </div>
    <% trend = @dashboard.spend_trend(months_count: 4) %>
    <% if trend.any? { |point| point[:total_spent_cents].positive? } %>
      <% chart_width = 480; chart_height = 320; left_pad = 42; right_pad = 8; top_pad = 12; bottom_pad = 24 %>
      <% plot_width = chart_width - left_pad - right_pad; plot_height = chart_height - top_pad - bottom_pad %>
      <% max_value = [ trend.map { |point| point[:total_spent_cents] }.max, 1 ].max %>
      <% min_value = trend.map { |point| point[:total_spent_cents] }.min %>
      <% axis_min = min_value - (min_value * 0.02) %>
      <% axis_range = [ max_value - axis_min, 1 ].max %>
      <% step = trend.size > 1 ? plot_width / (trend.size - 1).to_f : 0 %>
      <% points = trend.each_with_index.map { |point, i| [ (left_pad + i * step).round(2), (top_pad + plot_height - ((point[:total_spent_cents] - axis_min) / axis_range.to_f) * plot_height).round(2) ] } %>
      <% line_path = points.each_with_index.map { |(x, y), i| "#{i.zero? ? "M" : "L"} #{x},#{y}" }.join(" ") %>
      <% area_path = "#{line_path} L #{points.last[0]},#{top_pad + plot_height} L #{points.first[0]},#{top_pad + plot_height} Z" %>
      <% y_ticks = [ axis_min, (axis_min + max_value) / 2.0, max_value ] %>
      <svg viewBox="0 0 <%= chart_width %> <%= chart_height %>" class="w-full">
        <% y_ticks.each do |tick_value| %>
          <% tick_y = (top_pad + plot_height - ((tick_value - axis_min) / axis_range.to_f) * plot_height).round(2) %>
          <line x1="<%= left_pad %>" y1="<%= tick_y %>" x2="<%= chart_width - right_pad %>" y2="<%= tick_y %>" stroke="#e5e7eb" stroke-width="1"/>
          <text x="<%= left_pad - 6 %>" y="<%= tick_y + 3 %>" font-size="9" text-anchor="end" fill="#6b7280"><%= chart_tick_label(tick_value) %></text>
        <% end %>
        <path d="<%= area_path %>" fill="#4f46e5" fill-opacity="0.08" stroke="none"/>
        <path d="<%= line_path %>" fill="none" stroke="#4f46e5" stroke-width="2"/>
        <% last_x, last_y = points.last %>
        <circle cx="<%= last_x %>" cy="<%= last_y %>" r="3.5" fill="#4f46e5"/>
        <% trend.each_with_index do |point, i| %>
          <% next unless trend.size <= 6 || i.even? || i == trend.size - 1 %>
          <text x="<%= points[i][0] %>" y="<%= chart_height - 6 %>" font-size="10" text-anchor="middle" fill="#6b7280"><%= point[:month].strftime("%b") %></text>
        <% end %>
      </svg>
    <% else %>
      <%= empty_state(:chart) { "No spending data yet." } %>
    <% end %>
  </div>
</div>

<div class="mb-6 rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
  <div class="mb-4 flex items-baseline justify-between">
    <h2 class="text-base font-semibold text-gray-900">Investment transfers</h2>
    <span class="text-xs text-gray-500">From the user's Plaid-categorized transactions</span>
  </div>
  <% recent_investments = @dashboard.recent_investment_transactions %>
  <% if recent_investments.any? %>
    <ul class="divide-y divide-gray-100">
      <% recent_investments.each do |transaction| %>
        <li class="flex items-center justify-between py-3">
          <div>
            <p class="text-sm font-medium text-gray-900"><%= investment_transfer_label(transaction) %></p>
            <p class="text-xs text-gray-500"><%= transaction.posted_at.strftime("%b %-d, %Y") %></p>
          </div>
          <p class="text-sm font-semibold text-gray-900"><%= number_to_currency(transaction.amount_cents / 100.0) %></p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= empty_state(:chart) { "No investment transfers yet." } %>
  <% end %>
</div>
