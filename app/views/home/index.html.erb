<% content_for :title, "Dashboard" %>

<div class="mb-8">
  <h1 class="text-2xl font-semibold text-gray-900">Dashboard</h1>
  <p class="mt-1 text-sm text-gray-500">Signed in as <%= current_user.email %></p>
</div>

<% if @budget_alerts.any? %>
  <div class="mb-6 space-y-2">
    <% @budget_alerts.each do |alert| %>
      <div class="flex items-center justify-between rounded-md bg-red-50 px-4 py-3 text-sm text-red-800">
        <p>
          <span class="font-medium"><%= alert.budget.category.name %></span> is over budget this month:
          spent <%= number_to_currency(alert.spent_cents / 100.0) %> of a
          <%= number_to_currency(alert.budget.monthly_limit_cents / 100.0) %> limit.
        </p>
        <%= button_to "Dismiss", budget_alert_path(alert), method: :patch,
              class: "cursor-pointer border-0 bg-transparent p-0 font-medium text-red-800 hover:text-red-900" %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
    <p class="text-sm font-medium text-gray-500">Spent this month</p>
    <p class="mt-2 text-2xl font-semibold text-gray-900"><%= number_to_currency(@dashboard.spent_this_month_cents / 100.0) %></p>
    <p class="mt-1 text-xs font-medium <%= kpi_delta_class(@dashboard.spent_this_month_cents, @dashboard.spent_last_month_cents, good_when: :down) %>">
      <%= kpi_delta_text(@dashboard.spent_this_month_cents, @dashboard.spent_last_month_cents) %>
    </p>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
    <p class="text-sm font-medium text-gray-500">Budget remaining</p>
    <p class="mt-2 text-2xl font-semibold text-gray-900"><%= number_to_currency(@dashboard.budget_remaining_cents / 100.0) %></p>
    <p class="mt-1 text-xs font-medium text-gray-500">
      <% if @dashboard.budget_used_pct %>
        <%= number_with_precision(@dashboard.budget_used_pct, precision: 0) %>% of <%= number_to_currency(@dashboard.total_budget_cents / 100.0) %> used
      <% else %>
        No budgets set for this month
      <% end %>
    </p>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
    <p class="text-sm font-medium text-gray-500">Invested this month</p>
    <p class="mt-2 text-2xl font-semibold text-gray-900"><%= number_to_currency(@dashboard.invested_this_month_cents / 100.0) %></p>
    <p class="mt-1 text-xs font-medium <%= kpi_delta_class(@dashboard.invested_this_month_cents, @dashboard.invested_last_month_cents, good_when: :up) %>">
      <%= kpi_delta_text(@dashboard.invested_this_month_cents, @dashboard.invested_last_month_cents) %>
    </p>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
    <p class="text-sm font-medium text-gray-500">Over budget</p>
    <p class="mt-2 text-2xl font-semibold text-gray-900"><%= @dashboard.over_budget_budgets.size %></p>
    <p class="mt-1 text-xs font-medium <%= @dashboard.over_budget_budgets.any? ? "text-red-600" : "text-gray-400" %>">
      <% if @dashboard.over_budget_budgets.any? %>
        <%= @dashboard.over_budget_budgets.map { |budget| budget.category.name }.join(", ") %>
      <% else %>
        All categories on track
      <% end %>
    </p>
  </div>
</div>

<div class="mb-6 grid grid-cols-1 gap-4 lg:grid-cols-2">
  <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
    <div class="mb-4 flex items-baseline justify-between">
      <h2 class="text-base font-semibold text-gray-900">Budget vs. actual</h2>
      <span class="text-xs text-gray-500"><%= Date.current.strftime("%B %Y") %></span>
    </div>
    <% comparisons = @dashboard.budget_comparisons %>
    <% if comparisons.any? %>
      <% zero_x = 370; scale = 2; row_height = 40 %>
      <svg viewBox="0 0 600 <%= comparisons.size * row_height + 20 %>" class="w-full">
        <line x1="<%= zero_x %>" y1="4" x2="<%= zero_x %>" y2="<%= comparisons.size * row_height %>" stroke="#d1d5db" stroke-width="1"/>
        <% comparisons.each_with_index do |comparison, i| %>
          <% y_center = 30 + i * row_height %>
          <% clamped = comparison[:delta_pct].clamp(-100, 100) %>
          <% if clamped >= 0 %>
            <% bar_x = zero_x; bar_w = clamped * scale %>
          <% else %>
            <% bar_w = -clamped * scale; bar_x = zero_x - bar_w %>
          <% end %>
          <text x="355" y="<%= y_center + 4 %>" font-size="11.5" text-anchor="end" fill="#111827"><%= comparison[:category_name] %></text>
          <% if bar_w < 1 %>
            <circle cx="<%= zero_x %>" cy="<%= y_center %>" r="4.5" fill="<%= budget_status_color(comparison[:status]) %>"/>
          <% else %>
            <rect x="<%= bar_x %>" y="<%= y_center - 11 %>" width="<%= bar_w %>" height="22" rx="4" fill="<%= budget_status_color(comparison[:status]) %>"/>
          <% end %>
          <% sign = comparison[:delta_pct] >= 0 ? "+" : "−" %>
          <% pct_label = "#{sign}#{number_with_precision(comparison[:delta_pct].abs, precision: 0)}%" %>
          <% if clamped >= 0 %>
            <text x="<%= bar_x + [ bar_w, 1 ].max + 6 %>" y="<%= y_center + 4 %>" font-size="11" text-anchor="start" fill="#6b7280"><%= pct_label %></text>
          <% else %>
            <text x="<%= bar_x - 6 %>" y="<%= y_center + 4 %>" font-size="11" text-anchor="end" fill="#6b7280"><%= pct_label %></text>
          <% end %>
        <% end %>
      </svg>

      <% cut = comparisons.select { |c| c[:status] == :critical }.sort_by { |c| -c[:delta_pct] } %>
      <% room = comparisons.select { |c| c[:status] == :good }.sort_by { |c| c[:delta_pct] } %>
      <div class="mt-4 space-y-2">
        <% if cut.any? %>
          <div class="flex gap-2 rounded-lg border border-gray-200 bg-gray-50 p-3">
            <div class="w-1 shrink-0 rounded bg-red-600"></div>
            <p class="text-xs leading-relaxed text-gray-600">
              <strong class="font-semibold text-gray-900">Cut back:</strong>
              <% cut.each_with_index do |c, i| %><%= ", " if i.positive? %><%= c[:category_name] %> is <%= number_with_precision(c[:delta_pct], precision: 0) %>% over (<%= number_to_currency((c[:spent_cents] - c[:budget_cents]) / 100.0) %> over)<% end %>.
            </p>
          </div>
        <% end %>
        <% if room.any? %>
          <div class="flex gap-2 rounded-lg border border-gray-200 bg-gray-50 p-3">
            <div class="w-1 shrink-0 rounded bg-green-600"></div>
            <p class="text-xs leading-relaxed text-gray-600">
              <strong class="font-semibold text-gray-900">Room to spend:</strong>
              <% room.each_with_index do |c, i| %><%= ", " if i.positive? %><%= c[:category_name] %> is only <%= number_with_precision(100 + c[:delta_pct], precision: 0) %>% used (<%= number_to_currency((c[:budget_cents] - c[:spent_cents]) / 100.0) %> left)<% end %>.
            </p>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="px-2 py-8 text-center text-sm text-gray-500">
        No budgets set for this month. <%= link_to "Set one up", new_budget_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %>.
      </p>
    <% end %>
  </div>

  <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
  <div class="border-b border-gray-200 p-5">
    <h2 class="text-base font-semibold text-gray-900"><%= Date.current.strftime("%B %Y") %> spending by category</h2>
    <p class="mt-1 text-sm text-gray-500">From the nightly summary rebuild — not computed live from transactions.</p>
  </div>
  <% if @monthly_summaries.any? %>
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Category</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Spent</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @monthly_summaries.each do |summary| %>
          <tr class="hover:bg-gray-50">
            <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-gray-900"><%= summary.category.name %></td>
            <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500"><%= number_to_currency(summary.total_spent_cents / 100.0) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="px-6 py-8 text-center text-sm text-gray-500">
      No spending data yet for this month. Browse your
      <%= link_to "categories", categories_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %>
      or connect a <%= link_to "bank account", bank_accounts_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %>
      to get started.
    </p>
  <% end %>
  </div>
</div>
